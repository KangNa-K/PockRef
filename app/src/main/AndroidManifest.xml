<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        PockRef Android 通过 Storage Access Framework (SAF) 访问用户文件,
        严格来说无需声明读写权限 — 但为了让应用在 Android 13/14 上更好地
        表达意图,以及为未来切换到 MediaStore PhotoPicker 预留空间,加上
        下列声明。READ_MEDIA_* 不会触发运行时弹窗,仅在应用实际调用
        MediaStore API 时才会被检查。
    -->

    <!-- Android 13+ (API 33+) 媒体读取 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+ (API 34+) 用户选择的媒体,PhotoPicker 自动使用 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- 旧版本兼容:API <= 32 仍可使用 READ_EXTERNAL_STORAGE 走 SAF 选择路径 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Camera: used by the "拍照" import option. Declaring
         this permission makes the app installable on devices
         without a camera (uses-feature is NOT required), but
         allows requesting camera access at runtime when the
         user taps the "拍照" button. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        A user-enabled interactive reference window. This is not used for S Pen
        input; it only allows the app to show the canvas above another app when
        the user explicitly enables the system "display over other apps" switch.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        S Pen input remains on MainActivity's standard framework dispatch path.
        It does not depend on the overlay permission.
    -->

    <!--
        Android 11+ (API 30+) Package Visibility:
        声明本应用会查询/启动哪些外部组件 — 没有这块,系统会屏蔽
        很多隐式 Intent (例如其他 app 的 ACTION_VIEW .pur 文件)
    -->
    <queries>
        <!-- 允许解析打开 .pur 场景文件的 Intent -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/octet-stream" />
        </intent>
        <!-- 允许使用系统文件选择器 -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- 允许使用系统文件保存器 -->
        <intent>
            <action android:name="android.intent.action.CREATE_DOCUMENT" />
            <data android:mimeType="application/octet-stream" />
        </intent>
        <!-- 允许使用系统分享 -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- 允许调用系统相机拍照 -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- V_NOW (2026-06-10 user spec "启动页 pockref 字体"):
             Downloadable Fonts 通过 GMS Core 的 fonts provider
             异步拉取。Android 11+ (API 30+) Package Visibility
             要求调用方显式声明会 query 的 provider authority
             才能 resolve 成功。这是 Google 推荐的标准 query
             方式。 -->
        <provider
            android:authorities="com.google.android.gms.fonts"
            android:name="com.google.android.gms.fonts"
            android:exported="false" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PockRef"
        tools:targetApi="34">

        <!-- FileProvider for sharing camera photo URIs with the
             system camera app (ACTION_IMAGE_CAPTURE). The camera
             writes the full-res JPEG to the content URI we supply
             via FileProvider.getUriForFile(). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".FloatingWindowService"
            android:exported="false"
            android:stopWithTask="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.pur" />
            </intent-filter>
            <!--
                V_NOW: dedicated .pur MIME type (registered in
                MainActivity.PUR_SCENE_MIME). File managers like
                Google's Files / Files-by-Google, Material Files,
                and Samsung My Files use the URI's MIME as the
                primary filter key for their "Open with" picker.
                With this filter, a .pur file's MIME (which the
                Save As flow now writes as application/x-pockref-
                scene via CreateDocument) directly maps PockRef
                as a candidate. After the user picks PockRef once
                for this MIME, the system remembers it as the
                default — subsequent taps skip the picker.
            -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-pockref-scene" />
                <data android:pathPattern=".*\\.pur" />
            </intent-filter>
            <!-- Catch-all for adb / `am start -a VIEW -d file://... -t */*` so the
                 app can be auto-launched with a .pur in CI / scripted tests.
                 The real picker path is the application/octet-stream filter above. -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.pur" />
            </intent-filter>
        </activity>
    </application>

</manifest>
